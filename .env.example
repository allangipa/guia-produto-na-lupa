# ID de Associado da Amazon.com.br. O padrão (guiaprodutona-20) já está em
# lib/site.ts; preencha só para sobrescrever em outro deploy.
NEXT_PUBLIC_AMAZON_TAG=
# URL canônica do site em produção
NEXT_PUBLIC_SITE_URL=https://guiaprodutonalupa.com.br

# Creators API da Amazon (foto, preço e link licenciados). Só libera com 10
# vendas qualificadas nos últimos 30 dias. Credenciais em Associates Central →
# Ferramentas → Creators API. No GitHub, vão em Settings → Secrets.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
